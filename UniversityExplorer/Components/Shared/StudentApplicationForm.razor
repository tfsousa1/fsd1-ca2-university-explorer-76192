@* Reusable form for creating and editing student applications. *@

<EditForm Model="Application" OnValidSubmit="SubmitForm">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="application-form">

        @* Student name field. *@
        <div class="application-form-row">
            <label>Student Name</label>
            <div class="application-form-input">
                <InputText class="form-control"
                           @bind-Value="Application.StudentName" />
                <ValidationMessage For="@(() => Application.StudentName)" />
            </div>
        </div>

        @* Email address field. *@
        <div class="application-form-row">
            <label>Email Address</label>
            <div class="application-form-input">
                <InputText class="form-control"
                           @bind-Value="Application.Email" />
                <ValidationMessage For="@(() => Application.Email)" />
            </div>
        </div>

        @* Country field. *@
        <div class="application-form-row">
            <label>Country</label>
            <div class="application-form-input">
                <InputText class="form-control"
                           @bind-Value="Application.Country" />
                <ValidationMessage For="@(() => Application.Country)" />
            </div>
        </div>

        @* University name field. *@
        <div class="application-form-row">
            <label>University Name</label>
            <div class="application-form-input">
                <InputText class="form-control"
                           @bind-Value="Application.University" />
                <ValidationMessage For="@(() => Application.University)" />
            </div>
        </div>

        @* Course name field. *@
        <div class="application-form-row">
            <label>Course Name</label>
            <div class="application-form-input">
                <InputText class="form-control"
                           @bind-Value="Application.Course" />
                <ValidationMessage For="@(() => Application.Course)" />
            </div>
        </div>

        <div class="application-form-actions">
            <button type="submit" class="btn btn-primary">
                Submit Application
            </button>
        </div>

    </div>

</EditForm>

@code {
    // Receives the application data from the parent page.
    [Parameter]
    public StudentApplication Application { get; set; } = new StudentApplication();

    // Notifies the parent page when the form is valid and submitted.
    [Parameter]
    public EventCallback OnSubmit { get; set; }

    // Invokes the parent page callback after successful validation.
    private async Task SubmitForm()
    {
        await OnSubmit.InvokeAsync();
    }
}